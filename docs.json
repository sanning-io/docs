{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Sanning",
  "colors": {
    "primary": "#3457D5",
    "light": "#7C97F0",
    "dark": "#16181D"
  },
  "background": {
    "color": {
      "light": "#F5F5F2",
      "dark": "#0E1118"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "family": "Geist",
    "source": "/fonts/Geist-Variable.woff2",
    "format": "woff2",
    "weight": 400
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/sanning-lowercase-ink.svg",
    "dark": "/logo/sanning-lowercase-paper.svg"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
