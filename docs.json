{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Sanning",
  "colors": {
    "primary": "#16181D",
    "light": "#F5F5F2",
    "dark": "#16181D"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0E1118"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "source": "/fonts/Geist-Variable.woff2",
      "format": "woff2",
      "weight": 600
    },
    "body": {
      "family": "Geist",
      "source": "/fonts/Geist-Variable.woff2",
      "format": "woff2",
      "weight": 400
    }
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon-midnight.svg"
  },
  "logo": {
    "light": "/logo/sanning-ink.svg",
    "dark": "/logo/sanning-paper.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Book a call",
      "href": "https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ18-Dhr-iEjRTlJFuFJNL9aTUjEu3pkzVx6VqyP3iRc_uZJd4hbdkog2KTmOml-hcmqhtGAqbfZ"
    }
  },
  "thumbnails": {
    "preset": "headline",
    "appearance": "light",
    "surface": "neutral",
    "fonts": {
      "family": "Instrument Sans"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "sandbox"
        ]
      },
      {
        "group": "Record your agents",
        "pages": [
          "adapters/index",
          "adapters/langchain",
          "adapters/build-your-own"
        ]
      },
      {
        "group": "Evidence",
        "pages": [
          "evidence/build",
          "evidence/verify"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli"
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "cursor"
    ]
  },
  "integrations": {
    "telemetry": {
      "enabled": false
    }
  },
  "icons": {
    "library": "lucide"
  }
}
