{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Sanning",
  "colors": {
    "primary": "#3457D5",
    "light": "#7C97F0",
    "dark": "#16181D"
  },
  "background": {
    "color": {
      "light": "#F5F5F2",
      "dark": "#0E1118"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "family": "Geist",
    "source": "/fonts/Geist-Variable.woff2",
    "format": "woff2",
    "weight": 400
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon-midnight.svg"
  },
  "logo": {
    "light": "/logo/sanning-lowercase-ink.svg",
    "dark": "/logo/sanning-lowercase-paper.svg"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/how-it-works",
          "concepts/trust-boundary",
          "concepts/witness"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/anchor",
          "guides/langchain",
          "guides/file-records",
          "guides/log-store",
          "guides/bucket",
          "guides/keys-and-scopes",
          "guides/environments"
        ]
      },
      {
        "group": "Verify",
        "pages": [
          "verify/browser",
          "verify/cli",
          "verify/what-a-verdict-means"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli",
          "reference/scopes",
          "reference/errors",
          "reference/wire-formats"
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
