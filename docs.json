{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Sanning",
  "colors": {
    "primary": "#16181D",
    "light": "#F5F5F2",
    "dark": "#16181D"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0E1118"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "family": "Geist",
    "source": "/fonts/Geist-Variable.woff2",
